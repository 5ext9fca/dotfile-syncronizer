# macOS Finder metadata.
.DS_Store

# Python-generated bytecode caches.
__pycache__/
*.py[cod]

# Fish rewrites its universal-variable cache in place, so it is
# application-owned runtime state: it is neither tracked nor hard-linked.
configs/fish/fish_variables

# Local Python environments and secrets.
.venv/
.env
.env.*
!.env.example
